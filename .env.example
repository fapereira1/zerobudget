# Desenvolvimento local: a API lê o ambiente; não carrega este arquivo automaticamente.
API_BIND=127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3000
DEX_ISSUER=http://localhost:5556
DEX_CLIENT_ID=rust-app
DEX_CLIENT_SECRET=secret-rust-app-key
AUTH_ALLOW_LOCAL_HTTP=true

# Em produção: URLs HTTPS, segredo externo e AUTH_ALLOW_LOCAL_HTTP=false.
# O Compose/Dex atual usa sua própria configuração em config/dex-config.yaml.

# Armazenamento compartilhado de autenticação (inicie: docker compose up -d redis).
AUTH_SESSION_BACKEND=redis
AUTH_REDIS_PORT=6380
AUTH_REDIS_URL=redis://127.0.0.1:6380/0
AUTH_REDIS_NAMESPACE=zerobudget-local
AUTH_REDIS_TIMEOUT_MS=3000
AUTH_MAX_PENDING=1024
AUTH_MAX_SESSIONS=4096
# Alternativa explícita para desenvolvimento: AUTH_SESSION_BACKEND=memory.
# Em produção: URL rediss:// com autenticação, namespace exclusivo e TLS validado.
