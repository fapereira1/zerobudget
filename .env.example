# Desenvolvimento local: a API lê o ambiente; não carrega este arquivo automaticamente.
API_BIND=127.0.0.1:3000
API_PUBLIC_URL=http://localhost:3000
DEX_ISSUER=http://localhost:5556
DEX_CLIENT_ID=rust-app
DEX_CLIENT_SECRET=secret-rust-app-key
AUTH_ALLOW_LOCAL_HTTP=true

# Em produção: URLs HTTPS, segredo externo e AUTH_ALLOW_LOCAL_HTTP=false.
# O Compose/Dex atual usa sua própria configuração em config/dex-config.yaml.
